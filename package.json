{
  "name": "desktop-telematico",
  "version": "0.1.0",
  "author": "DXC Technology",
  "description": "Desktop Telematico Entrate — front end Electron + React per l'applicazione desktop dell'Agenzia delle entrate (profili Entratel e Fisconline).",
  "private": true,
  "type": "module",
  "main": "out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:electron": "electron-vite build && electron-builder",
    "build:win": "electron-vite build && electron-builder --publish never --win",
    "build:mac": "electron-vite build && electron-builder --publish never --mac",
    "build:linux": "electron-vite build && electron-builder --publish never --linux",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "start": "electron-vite preview",
    "lint": "eslint .",
    "selfcheck": "tsc -p tsconfig.selfcheck.json && node scripts/run-selfchecks.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "rebuild:native": "npx @electron/rebuild -f -w better-sqlite3",
    "prepare": "husky"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "better-sqlite3": "^12.9.0",
    "bootstrap": "^5.3.8",
    "i18next": "^25.6.0",
    "react-bootstrap": "^2.10.10",
    "react-i18next": "^16.2.3",
    "react-router-dom": "^7.9.4",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^4.2.3",
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^41.2.1",
    "electron-builder": "^26.8.1",
    "electron-vite": "^6.0.0-beta.1",
    "eslint": "^10.2.0",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "playwright": "^1.62.1",
    "prettier": "3.9.6",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.8"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "electron@41.10.7": true,
    "esbuild@0.25.12": true,
    "electron-winstaller@5.4.0": true
  }
}
